{
  "manifest_version": 3,
  "name": "TaskFlow Quick Add",
  "description": "Add tasks to TaskFlow from any webpage using the context menu or a keyboard shortcut",
  "version": "1.0.0",
  "icons": {
    "16": "/extension/icons/icon-16.png",
    "32": "/extension/icons/icon-32.png",
    "48": "/extension/icons/icon-48.png",
    "128": "/extension/icons/icon-128.png"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "TaskFlow Quick Add"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "add-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Add selected text as a task"
    }
  },
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/content.js"],
      "css": ["extension/styles.css"]
    }
  ],
  "options_page": "extension/options.html",
  "host_permissions": ["http://localhost:3000", "https://*.taskflow.app"]
}
